# .env of the AWS GPU server (/opt/callsight/.env, chmod 600). Never commit the filled file.
# No PBX secret, no APP_SECRET, no AWS key belongs here.

MAIN_IP=10.20.1.10                       # the main server's private address
POSTGRES_PASSWORD=                       # same value as on the main server
REDIS_PASSWORD=                          # same value as on the main server

# Same values as on the main server (they decide what counts as "work left")
ASR_START_DATE=
ASR_MODEL=whisper-large-v3
ASR_MIN_TALK=5
ASR_MAX_SECONDS=3600
ASR_BATCH=50
ASR_IDLE_UNLOAD_S=300
NLP_ENABLED=false
LLM_MODEL=qwen2.5:7b
LLM_NUM_CTX=8192
