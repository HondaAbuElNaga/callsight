# .env of the AWS MAIN server (/opt/callsight/.env, chmod 600). Never commit the filled file.
# Everything not listed here keeps the meaning described in .env.example.

# --- AWS only ---
MAIN_IP=10.20.1.10                       # the server's fixed private address (set in callsight.yaml)
REDIS_PASSWORD=                          # openssl rand -hex 32   (letters and digits only: it is part of an address)
SITE_NAME=                               # web address without https://, e.g. calls.example.com

# --- PBX through the Yeastar remote address (certificate check ON: it is a real certificate) ---
YEASTAR_BASE_URL=https://sstli.ras.yeastar.com
YEASTAR_CLIENT_ID=
YEASTAR_CLIENT_SECRET=
YEASTAR_VERIFY_SSL=true

# --- database, folders, web page ---
POSTGRES_PASSWORD=                       # openssl rand -hex 32
APP_SECRET=                              # openssl rand -hex 32   (new one: the PC's logins are not valid here)
AUDIO_HOST_DIR=/srv/callsight/audio
REPORTS_HOST_DIR=/srv/callsight/reports
BACKUP_HOST_DIR=/srv/callsight/backup    # same disk; the daily AWS disk snapshots are the second copy
BACKUP_OFFSITE_CONFIRMED=false
RETENTION_ENABLED=false
WEB_PORT=8080

# --- transcription + analysis (the work itself runs on the GPU server; same values in its .env) ---
ASR_START_DATE=                          # the go-live day, YYYY-MM-DD: AWS starts empty, new calls only
ASR_MODEL=whisper-large-v3
ASR_MIN_TALK=5
ASR_MAX_SECONDS=3600
ASR_BATCH=50
NLP_ENABLED=false
LLM_MODEL=qwen2.5:7b
LLM_NUM_CTX=8192

# --- live board: off until it is tested through the Yeastar remote address ---
LIVE_ENABLED=false
LISTEN_ENABLED=false
