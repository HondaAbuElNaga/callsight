# Copy this file to .env and fill in the values. Never share .env or commit it.

# Address of the Yeastar admin portal, exactly as in the browser bar (no trailing slash)
# e.g. https://192.168.1.50:8088
YEASTAR_BASE_URL=https://192.168.1.50:8088

# From Yeastar admin portal -> Integrations -> API
YEASTAR_CLIENT_ID=
YEASTAR_CLIENT_SECRET=

# Most office PBXs use a self-signed certificate -> keep false until the step below is done.
# Set true if the PBX has a real certificate (e.g. *.yeastarcloud.com domain).
YEASTAR_VERIFY_SSL=false
# Better: trust the PBX's own certificate (on the office LAN, once):
#   docker compose run --rm worker python -m callsight pbx-cert --fetch      -> prints its SHA-256 fingerprint
#   compare it with the PBX web interface, then (config/ is read-only in the services, so mount it writable once):
#   docker compose run --rm -v ./config:/app/config worker python -m callsight pbx-cert --accept <fingerprint>
# YEASTAR_CA_FILE=/app/config/pbx-ca.pem
# Only if the certificate does not name the PBX's LAN address (still checked against that one certificate):
# YEASTAR_TLS_CHECK_HOSTNAME=false
# Optional extra pin, checked before every login. Only together with YEASTAR_CA_FILE (alone = startup error:
# a pin on its own does not protect the API secret):
# YEASTAR_CERT_SHA256=AA:BB:...

# --- call ingest ---
# Database password (any long random text). The app containers build their own DATABASE_URL from it.
POSTGRES_PASSWORD=change-me
# Used by the command line on this PC (Postgres is published on 127.0.0.1:5433 only)
DATABASE_URL=postgresql+psycopg://callsight:change-me@127.0.0.1:5433/callsight
TEST_DATABASE_URL=postgresql+psycopg://callsight:change-me@127.0.0.1:5433/callsight_test
# Where recordings are saved (same folder for the command line and the containers)
AUDIO_DIR=D:/callsight-data/audio
AUDIO_HOST_DIR=D:/callsight-data/audio

# --- web page ---
# Random text, at least 32 characters; signs the login cookie. Changing it logs everyone out.
APP_SECRET=change-me
# Port of the web page on this PC: http://127.0.0.1:8080
WEB_PORT=8080

# --- backups + retention (hardening spec) ---
# Nightly backup target (01:30). Same disk as the audio protects against mistakes, NOT against disk loss:
# point this to an encrypted second disk / NAS, then set BACKUP_OFFSITE_CONFIRMED=true (removes the health warning).
BACKUP_HOST_DIR=D:/callsight-backup
BACKUP_OFFSITE_CONFIRMED=false
# PDPL retention: off until decided. Also set "days" (>= 30) in config/retention.yaml. First night = dry run only.
RETENTION_ENABLED=false
# --- transcription (asr worker, spec 2026-11-14-transcription) ---
# Automatic transcription is OFF until this date is set (YYYY-MM-DD): only calls from that day on are queued.
# Older calls only via: python -m callsight transcribe --days N --limit M
ASR_START_DATE=
# Must match the compose profile: whisper-large-v3 (default, MIT) | audar-asr-turbo (licence limits!) with
# profile "asr";  jais-asr-4bit with profile "asr-jais" (server only, needs > 8 GB GPU)
ASR_MODEL=whisper-large-v3
# Calls with less talk time are marked skipped; longer than ASR_MAX_SECONDS too
ASR_MIN_TALK=5
ASR_MAX_SECONDS=3600
# At most this many calls queued per 5-minute run
ASR_BATCH=50
# Free the GPU after this many idle seconds (so other GPU jobs can run)
ASR_IDLE_UNLOAD_S=300

# --- call analysis (local LLM, spec 2026-11-14-call-analysis) ---
# Automatic analysis of new transcripts: OFF until the llm profile runs
#   (docker compose --profile llm up -d ollama nlp-worker)
NLP_ENABLED=false
# Ollama model; pull it once first: docker compose --profile llm-pull run --rm ollama-pull qwen2.5:7b
LLM_MODEL=qwen2.5:7b
# Context window in tokens (long calls are trimmed head+tail to fit)
LLM_NUM_CTX=8192
# Base model of the satisfaction fine-tune (callsight.analysis.train). Only licence-checked models run:
# CAMeLBERT-DA (Apache-2.0) at this pinned revision. MARBERT is refused (research-only licence).
# These are the built-in defaults; the asr-worker container does not read .env, so to change them pass
# `-e SAT_BASE_MODEL=... -e SAT_BASE_REVISION=...` on the `docker compose run` line (and extend the allow-list).
SAT_BASE_MODEL=CAMeL-Lab/bert-base-arabic-camelbert-da
SAT_BASE_REVISION=231698eab9ebf0ae7b518a64277b81b2fe829f2d

# --- live call board (spec 2026-11-14-live-board) ---
# OFF. Only on the office LAN, after "Call Status Monitor" is enabled per trunk on the PBX:
#   set LIVE_ENABLED=true, then: docker compose --profile live up -d live
# The live service makes its OWN PBX login (max 1 per 10 min). Token budget of the API Client ID (max 8 open):
# worker 1 + command line 1 + live 1 = 3. A refused login or "token limit" stops ALL PBX logins (Redis key
# pbx:auth_blocked) until a person fixes the cause and runs:
#   docker compose run --rm worker python -m callsight pbx-unblock
# Its own token is kept in a 0600 file on the volume `live-state` (only the live service mounts it), not in Redis.
# The live service gets only YEASTAR_* and REDIS_URL from compose (no APP_SECRET, no DB password).
LIVE_ENABLED=false
# Web addresses allowed to open the live WebSocket (exact match, comma separated). Empty = this PC only:
# http://127.0.0.1:WEB_PORT and http://localhost:WEB_PORT
LIVE_ORIGINS=
# Silent listen: keep false. Paused by the user. Before it may ever be true: IVR notice "calls may be recorded or
# monitored", a written staff monitoring policy, and legal confirmation (PDPL; Anti-Cyber Crime Law art. 3).
LISTEN_ENABLED=false
